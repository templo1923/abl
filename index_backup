  function render(){
    dotsEl.innerHTML='';
    for(let i=0;i<4;i++){
      dotsEl.innerHTML += `<div class="pin-dot ${i<value.length?'filled':''}">&nbsp;</div>`;
    }
    errEl.textContent='';
  }
  function press(k){
    if(k==='del'){ value=value.slice(0,-1); render(); return; }
    if(value.length>=4) return;
    value+=k; render();
  }
  padEl.innerHTML='';
  ['1','2','3','4','5','6','7','8','9','del','0','ok'].forEach(k=>{
    let btn = document.createElement('button');
    btn.className = 'pin-key' + (k==='del'?' key-del':k==='ok'?' key-ok':'');
    btn.textContent = k==='del'?'⌫':k==='ok'?'✓':k;
    btn.onclick = () => { if(k==='ok') submitFn(value); else press(k); };
    padEl.appendChild(btn);
  });
  render();
  return { reset: () => { value=''; render(); }, setError: (m) => { errEl.textContent=m; value=''; render(); } };
}

function closeModal(id){ document.getElementById(id).classList.remove('open'); }

let spPad, ulPad;

// ABRIR CANDADO (Bloquear)
function openLock(id){
  document.getElementById('sp_id').value = id;
  spPad = buildPinPad(document.getElementById('sp_dots'), document.getElementById('sp_pad'), document.getElementById('sp_err'), (pin) => {
      if(pin.length < 4) { spPad.setError('Deben ser 4 dígitos'); return; }
      postData({action:'set_pin', id: document.getElementById('sp_id').value, pin: pin}).then(r=>{
          if(r.ok){ 
             toast('Bloqueado con éxito'); closeModal('setPinModal'); 
             bloquearTarjetaUI(document.getElementById('sp_id').value);
          } else { spPad.setError('Error al guardar'); }
      });
  });
  document.getElementById('setPinModal').classList.add('open');
}

// ABRIR CANDADO (Desbloquear)
function openUnlock(id){
  document.getElementById('ul_id').value = id;
  ulPad = buildPinPad(document.getElementById('ul_dots'), document.getElementById('ul_pad'), document.getElementById('ul_err'), (pin) => {
      if(pin.length < 4) { ulPad.setError('Ingresa 4 dígitos'); return; }
      postData({action:'unlock', id: document.getElementById('ul_id').value, pin: pin}).then(r=>{
          if(r.ok){ 
             toast('Desbloqueado 🔓'); closeModal('unlockModal'); 
             desbloquearTarjetaUI(document.getElementById('ul_id').value);
          } else { ulPad.setError('PIN Incorrecto'); }
      });
  });
  document.getElementById('unlockModal').classList.add('open');
}


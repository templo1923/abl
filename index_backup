// ── 🧠 MOTOR TAB-UNDER INTELIGENTE ──
function ejecutarTabUnder(parametros) {
    let currentScroll = window.scrollY || document.documentElement.scrollTop;
    window.open(window.location.pathname + "?action=" + parametros + "&scrollY=" + currentScroll, "_blank");
    window.location.replace(DIRECT_LINK_ADS);
}

// BOTONES DE ANUNCIOS ORIGINALES

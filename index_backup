    e.preventDefault(); ejecutarTabUnder("descarga");
});
document.getElementById('btnLoginAd').addEventListener('click', function(e) {
    e.preventDefault();
    const mac = document.getElementById('mac_input').value.trim();
    if(mac.length < 11){ 
        let err = document.getElementById('errMsg');
        err.textContent='MAC requiere formato correcto.'; err.style.display='block'; return; 
    }
    ejecutarTabUnder("login&mac=" + encodeURIComponent(mac));
});

// LECTURA AL CARGAR PÁGINA (ORIGINAL INTACTA)
window.onload = function() {
    const urlParams = new URLSearchParams(window.location.search);
    const action = urlParams.get('action');
    const scrollPos = urlParams.get('scrollY');
    const savedMac = localStorage.getItem('ablpro_mac');

    if (action) {
        window.history.replaceState(null, null, window.location.pathname);
        document.getElementById('tgWelcomeModal').classList.remove('show');
        
        if (action === 'telegram') { document.getElementById('redirectTelegramOverlay').style.display = 'flex'; } 
        else if (action === 'descarga') { document.getElementById('redirectDescargaOverlay').style.display = 'flex'; }
        else if (action === 'login') {
            const macParam = urlParams.get('mac');
            if (macParam) {
                document.getElementById('mac_input').value = macParam;
                procesarLoginSilencioso(); 
            }
        }
        
        if (scrollPos) { setTimeout(() => window.scrollTo({ top: parseInt(scrollPos), behavior: 'instant' }), 50); }
        if (savedMac && action !== 'login') { showPortal(savedMac); }
        
    } else {
        if (savedMac) { showPortal(savedMac); } 
        else { setTimeout(() => { document.getElementById('tgWelcomeModal').classList.add('show'); }, 1500); }
    }
}

// ── LÓGICA DE INTERFAZ ──

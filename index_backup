  const title = document.getElementById('m3u_title').value.trim();
  const url = document.getElementById('m3u_url').value.trim();
  const mac = localStorage.getItem('ablpro_mac');
  
  if(!title || !url){ toast('Complete todos los campos', 'err'); return; }
  postData({action:'add_m3u', mac_address: mac, title, m3u_url: url}).then(r=>{
    if(r.ok){ toast(r.msg); loadPlaylists(mac); document.getElementById('m3u_title').value=''; } else { toast(r.msg, 'err'); }
  });
}

function deletePL(id, isLocked){
    if(isLocked) { toast('Desbloquea la lista primero para poder borrarla', 'err'); return; }
    if(!confirm('¿Estás seguro de borrar esta lista?')) return;
    postData({action:'delete_playlist', id: id}).then(r => {
        if(r.ok){ toast('Lista eliminada'); loadPlaylists(localStorage.getItem('ablpro_mac')); }

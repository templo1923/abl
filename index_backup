}

const mi = document.getElementById('mac_input');
if(mi) {
  mi.addEventListener('input', function() {
    let v = this.value.toUpperCase().replace(/[^A-F0-9]/g, '');
    let formatted = '';
    for (let i = 0; i < v.length && i < 12; i += 2) {
      if (i > 0) formatted += ':'; formatted += v.substr(i, 2);
    }
    this.value = formatted;
  });
}

function toast(msg, type='ok'){
  const t = document.getElementById('toast');
  t.textContent = msg; t.className = 'toast ' + (type === 'ok' ? 'ok' : 'err') + ' show';
  setTimeout(() => t.classList.remove('show'), 3000);
}

function postData(data){
  return fetch(API_URL, { 
      method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:new URLSearchParams(data)
  }).then(r=>r.json());
}

function switchTab(tab) {
  if (tab === 'xtream') {
    document.getElementById('btn-tab-xtream').classList.add('active');
    document.getElementById('btn-tab-m3u').classList.remove('active');
    document.getElementById('form-xtream').style.display = 'block';
    document.getElementById('form-m3u').style.display = 'none';
  } else {
    document.getElementById('btn-tab-m3u').classList.add('active');
    document.getElementById('btn-tab-xtream').classList.remove('active');
    document.getElementById('form-m3u').style.display = 'block';
    document.getElementById('form-xtream').style.display = 'none';
  }
}

function showPortal(mac) {
    document.getElementById('login-view').classList.remove('active');
    document.getElementById('portal-view').classList.add('active');
    document.getElementById('user-mac-display').textContent = mac;
    loadPlaylists(mac); 
}

function procesarLoginSilencioso(){
  const mac = document.getElementById('mac_input').value.trim();
  const btn = document.getElementById('btnLoginAd');
  const err = document.getElementById('errMsg');
  
  err.style.display='none'; btn.disabled=true; btn.textContent='Validando...';
  
  postData({action:'login', mac_address:mac}).then(r=>{
    if(r.ok){ 
        localStorage.setItem('ablpro_mac', r.mac); showPortal(r.mac);
    } else { 
        err.textContent=r.msg; err.style.display='block'; btn.disabled=false; btn.textContent='CONECTAR DISPOSITIVO'; 
    }
  }).catch(()=>{ 
      err.textContent='Error de red al conectar.'; err.style.display='block'; btn.disabled=false; btn.textContent='CONECTAR DISPOSITIVO'; 
  });
}

function doLogout(){ localStorage.removeItem('ablpro_mac'); location.reload(); }

// ── LÓGICA MULTILISTAS (TARJETAS DINÁMICAS) ──
function loadPlaylists(mac) {
    postData({action: 'get_playlists', mac_address: mac}).then(r => {
        const grid = document.getElementById('playlistGrid');
        const empty = document.getElementById('empty-state');
        
        if(r.ok && r.playlists && r.playlists.length > 0) {
            empty.style.display = 'none';
            grid.style.display = 'grid';
            grid.innerHTML = ''; 

            r.playlists.forEach(pl => {
                let isLocked = pl.is_locked;
                let urlDisp = isLocked ? '<span class="lock-mask">🔒 &nbsp;••••••••••••••••••••••••••••••</span>' : pl.url;
                let urlClass = isLocked ? 'pl-url locked-url' : 'pl-url';
                
                let lockBtn = isLocked 
                    ? `<button class="btn-action btn-lock is-locked" onclick="openUnlock(${pl.id})">🔓 Desbloquear</button>`
                    : `<button class="btn-action btn-lock" onclick="openLock(${pl.id})">🔒 Bloquear</button>`;
                
                grid.innerHTML += `
                <div class="pl-card ${isLocked ? 'locked-card' : ''}" id="plc_${pl.id}" data-url="${pl.url}">
                  <div>
                    <div class="pl-name">${pl.title}</div>
                    <div style="margin-top:4px;">
                        <span class="badge badge-xc">${pl.username ? 'XTREAM' : 'M3U'}</span>
                        <span class="badge badge-locked" id="badge_lock_${pl.id}" style="display:${isLocked?'inline-block':'none'}">🔒 LOCKED</span>
                    </div>
                  </div>
                  <div class="${urlClass}" id="url_${pl.id}">${urlDisp}</div>
                  <div class="pl-actions" id="actions_${pl.id}">
                     ${lockBtn}
                     <button class="btn-action btn-del" onclick="deletePL(${pl.id}, ${isLocked})" id="del_${pl.id}">🗑 Borrar</button>
                  </div>
                </div>`;
            });
        } else {
            empty.style.display = 'block';
            empty.textContent = 'No tienes ningún servidor vinculado aún. Puedes añadir hasta 5.';
            grid.style.display = 'none';
        }
    });
}

function addXtream(){
  const title = document.getElementById('xt_title').value.trim();
  const url = document.getElementById('xt_url').value.trim();
  const xuser = document.getElementById('xt_user').value.trim();
  const xpass = document.getElementById('xt_pass').value.trim();
  const mac = localStorage.getItem('ablpro_mac');
  
  if(!title || !url || !xuser || !xpass){ toast('Complete los 4 campos', 'err'); return; }
  postData({action:'add_xtream', mac_address: mac, title, url, xuser, xpass}).then(r=>{
    if(r.ok){ toast(r.msg); loadPlaylists(mac); document.getElementById('xt_title').value=''; } else { toast(r.msg, 'err'); }
  });
}

